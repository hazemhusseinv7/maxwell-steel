# Variables prefixed NEXT_PUBLIC_* ship to the browser - no secrets there.

# --- Sanity (public identifiers; safe for NEXT_PUBLIC_*) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=

# --- Sanity (server secrets) ---
# Read+write token for the private dataset (reads + writes + Studio ops).
SANITY_API_TOKEN=
# Shared secret for POST /api/webhooks/sanity signature verification.
# Generate with: openssl rand -hex 32
# (PowerShell: -join ((1..32 | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })))
# Must match the secret saved in the Sanity dashboard webhook settings.
SANITY_REVALIDATE_SECRET=

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
# Verified sender identity, e.g. "Maqrat <noreply@example.com>".
RESEND_FROM=
# Recipient of new-ticket admin alerts.
ADMIN_EMAIL=
# Newsletter delivery plane (Resend dashboard → Audience):
# segment that receives new-post broadcasts. Broadcasts resolve
# per-recipient unsubscribe pages automatically.
RESEND_SEGMENT_ID=
# Shared editor-visible token authorizing the Studio "Publish & notify"
# action (NEXT_PUBLIC_ = embedded in the Studio bundle by design).
# Authorizes only idempotent broadcast-of-published-post calls.
# Generate with: openssl rand -hex 32
NEXT_PUBLIC_BROADCAST_TOKEN=

# --- App ---
# Public base URL used for metadata, sitemap, RSS, emails, OG images.
NEXT_PUBLIC_APP_URL=http://localhost:3000
